# Copiar a .env y completar con valores reales.
# El archivo .env NO se versiona (está en .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=tiendainformatica
POSTGRES_USER=tienda
# Usar una password larga y sin caracteres especiales (;, =, comillas)
POSTGRES_PASSWORD=cambiame_por_una_password_segura

# --- API ---
# Puerto del host por el que se publica la API de productos.
# El 8080 queda reservado para el panel administrativo.
API_PORT=5001
# Orígenes permitidos para CORS, separados por coma. Vacío = permitir todos.
# Ejemplo: https://tienda.midominio.com
CORS_ALLOWED_ORIGINS=
