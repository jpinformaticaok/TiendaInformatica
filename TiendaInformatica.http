@host = http://localhost:5020

### Healthcheck (API + base de datos)
GET {{host}}/health

### Listar marcas (datos del seeding)
GET {{host}}/marcas

### Crear marca
POST {{host}}/marcas
Content-Type: application/json

{
  "nombre": "Samsung"
}

### Crear marca duplicada (debe devolver 409)
POST {{host}}/marcas
Content-Type: application/json

{
  "nombre": "Lenovo"
}

### Listar categorías (datos del seeding)
GET {{host}}/categorias

### Obtener una categoría
GET {{host}}/categorias/1

### Productos de una categoría
GET {{host}}/categorias/2/productos

### Crear categoría
POST {{host}}/categorias
Content-Type: application/json

{
  "nombre": "Almacenamiento",
  "descripcion": "Discos externos y pendrives"
}

### Crear categoría inválida (debe devolver 400)
POST {{host}}/categorias
Content-Type: application/json

{
  "nombre": "   ",
  "descripcion": "Sin nombre"
}

### Listar productos
GET {{host}}/productos

### Obtener un producto
GET {{host}}/productos/1

### Crear producto
POST {{host}}/productos
Content-Type: application/json

{
  "nombre": "Monitor 24\" Full HD",
  "marcaId": 2,
  "precio": 180000,
  "stock": 8,
  "categoriaId": 2
}

### Crear producto con marca inexistente (debe devolver 400)
POST {{host}}/productos
Content-Type: application/json

{
  "nombre": "Monitor roto",
  "marcaId": 999,
  "precio": 1000,
  "stock": 1,
  "categoriaId": 2
}

### Crear producto con categoría inexistente (debe devolver 400)
POST {{host}}/productos
Content-Type: application/json

{
  "nombre": "Monitor roto",
  "marcaId": 1,
  "precio": 1000,
  "stock": 1,
  "categoriaId": 999
}

### Actualizar producto
PUT {{host}}/productos/1
Content-Type: application/json

{
  "nombre": "Notebook 15.6\" i5 16GB",
  "marcaId": 1,
  "precio": 820000,
  "stock": 4,
  "categoriaId": 1
}

### Eliminar producto
DELETE {{host}}/productos/6
